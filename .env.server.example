# Copy is created by bun run server:setup. This file contains no secrets.
BORSA_SERVER_HOST=0.0.0.0
BORSA_SERVER_PORT=8787
# Free IEX / paid SIP. Paper API credentials are used only for read-only clock/data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
# Optional BIST end-of-day display; never used for intraday fills.
TWELVE_DATA_KEY=
# Provider-authorized HTTPS bridge, schema in docs/SERVER.md. No assumed Matriks endpoint.
LICENSED_FEED_URL=
LICENSED_FEED_TOKEN=
# Optional Apple push credentials, kept on the server only.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=dev.prototype.borsa
APNS_ENV=development
