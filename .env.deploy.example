# Copy to .env.deploy (gitignored). No package installation is needed.
# Existing environment variables take precedence. This file is never shell-executed.

# Optional override for DEVELOPMENT_TEAM; otherwise Config/Local.xcconfig is used.
BORSA_TEAM_ID=

# Required only for App Store Connect / TestFlight upload.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Optional; defaults to ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
APP_STORE_CONNECT_PRIVATE_KEY_PATH=
